# ==============================================================================
# FormMind AI - Backend Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env in your workspace root or backend directory:
#   PowerShell: Copy-Item backend\.env.example backend\.env
#   Bash:       cp backend/.env.example backend/.env
# ==============================================================================

# General & Environment
PROJECT_NAME="FormMind AI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Security & Sessions
SECRET_KEY="formmind-local-testing-super-secret-key-change-in-prod"
SUPABASE_JWT_SECRET=""
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default: Local SQLite)
DATABASE_URL="sqlite:///./formmind.db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000"

# Rate Limiting & Protection
RATE_LIMIT_PER_MINUTE=180
RATE_LIMIT_AUTH_PER_MINUTE=30
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# Google Cloud Platform OAuth 2.0 Credentials (Optional)
# ------------------------------------------------------------------------------
# Create an OAuth 2.0 Client ID in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Authorized JavaScript Origin: http://localhost:5173
# Authorized Redirect URI:      http://localhost:5173/auth/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/callback"

# ------------------------------------------------------------------------------
# AI Provider Configuration
# ------------------------------------------------------------------------------
# Options: 'auto' (built-in zero-cost deterministic engine), 'gemini', 'openai', 'groq', 'ollama'
AI_PROVIDER="auto"
AI_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
MODEL_NAME=""
OLLAMA_BASE_URL="http://localhost:11434"
