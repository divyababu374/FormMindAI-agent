# ==============================================================================
# FormMind AI - Environment Configuration
# ==============================================================================

# General
PROJECT_NAME="FormMind AI"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL="sqlite:///./formmind.db"

# Mode Configuration (Production defaults to DEMO_MODE=false)
DEMO_MODE=false

# ------------------------------------------------------------------------------
# Google Cloud Platform OAuth 2.0 Credentials
# ------------------------------------------------------------------------------
# Create an OAuth 2.0 Client ID in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Scopes required:
# 1. https://www.googleapis.com/auth/forms.body.readonly
# 2. https://www.googleapis.com/auth/forms.responses.readonly
# 3. https://www.googleapis.com/auth/spreadsheets.readonly
# 4. https://www.googleapis.com/auth/drive.readonly
# 5. openid, email, profile
#
# Authorized redirect URI:
# http://localhost:5173/auth/callback (for local frontend dev)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/callback"

# ------------------------------------------------------------------------------
# Optional AI Providers (FormMind AI works with built-in Deterministic Engine)
# ------------------------------------------------------------------------------
AI_PROVIDER="auto"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
MODEL_NAME=""
OLLAMA_BASE_URL="http://localhost:11434"
