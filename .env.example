# ==============================================================================
# FormMind AI - Local Development & Testing Environment Variables Template
# ==============================================================================
# Copy this file to .env before starting the application:
#
#   Windows (PowerShell):
#     Copy-Item .env.example .env
#
#   Windows (CMD):
#     copy .env.example .env
#
#   macOS / Linux (Bash):
#     cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="FormMind AI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# 2. Security & Session Settings
# ------------------------------------------------------------------------------
# For local testing, any string is fine. In production, use a 64-char random string.
SECRET_KEY="formmind-local-testing-super-secret-key-change-in-prod"
SUPABASE_JWT_SECRET=""
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 3. Database Configuration
# ------------------------------------------------------------------------------
# Default: Local SQLite database stored in root / backend directory.
DATABASE_URL="sqlite:///./formmind.db"

# Connection pooling settings (used when connecting to PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins (Local Development Ports)
# ------------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the backend API.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000"

# ------------------------------------------------------------------------------
# 5. Rate Limiting & Upload Safeguards
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=180
RATE_LIMIT_AUTH_PER_MINUTE=30
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# 6. Google Cloud Platform OAuth 2.0 (Optional - for Live Google Forms/Sheets Sync)
# ------------------------------------------------------------------------------
# Create an OAuth 2.0 Web Client in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Authorized JavaScript Origin:
#   http://localhost:5173
#
# Authorized Redirect URI:
#   http://localhost:5173/auth/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/callback"

# ------------------------------------------------------------------------------
# 7. Supabase Authentication Layer (Optional - Identity & User Profiles)
# ------------------------------------------------------------------------------
# In Supabase Dashboard: Project Settings > API
# Note: FormMind works out of the box with local guest mode if left empty.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ------------------------------------------------------------------------------
# 8. Frontend API Target & Analytics
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="http://127.0.0.1:8000/api"
VITE_GA_ID="G-SPWVNPXRQZ"
NEXT_PUBLIC_GA_ID="G-SPWVNPXRQZ"

# ------------------------------------------------------------------------------
# 9. AI Providers Configuration
# ------------------------------------------------------------------------------
# AI_PROVIDER options:
#   - 'auto'   : Zero-cost built-in deterministic statistical AI engine (Default - No API key required!)
#   - 'gemini' : Google Gemini API (Requires GEMINI_API_KEY)
#   - 'openai' : OpenAI GPT models (Requires OPENAI_API_KEY)
#   - 'groq'   : Ultra-fast Groq Llama models (Requires GROQ_API_KEY)
#   - 'ollama' : Local offline LLM via Ollama (Requires running Ollama on localhost:11434)
# ------------------------------------------------------------------------------
AI_PROVIDER="auto"
AI_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
MODEL_NAME=""
OLLAMA_BASE_URL="http://localhost:11434"
