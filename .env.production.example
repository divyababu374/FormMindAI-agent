# ==============================================================================
# FormMind AI - Production Environment Variables Template
# ==============================================================================
# Set these environment variables in your Vercel Project Settings:
# Project Settings > Environment Variables
# ==============================================================================

# General & Environment
ENVIRONMENT="production"
DEBUG=false
PROJECT_NAME="FormMind AI"
VERSION="1.0.0"

# Security (Generate a 64-char random hex string: openssl rand -hex 32)
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Production Database (Cloud PostgreSQL: Supabase, Neon, AWS RDS, Railway)
# For Vercel Serverless without Postgres, it will automatically fallback to /tmp/formmind.db
DATABASE_URL="postgresql://user:password@ep-cool-db.us-east-2.aws.neon.tech/formmind?sslmode=require"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
CORS_ORIGINS="https://form-mind-ai-agent.vercel.app,https://formmind-ai.vercel.app"

# Rate Limiting & Protection
RATE_LIMIT_PER_MINUTE=180
RATE_LIMIT_AUTH_PER_MINUTE=30
MAX_UPLOAD_SIZE_MB=50
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# Google Cloud Platform OAuth 2.0 Credentials (for Live Google Forms & Drive Sync)
# ------------------------------------------------------------------------------
# Create an OAuth 2.0 Web Client ID in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
#
# Authorized JavaScript origins:
# - https://your-project.vercel.app
#
# Authorized redirect URIs:
# - https://your-project.vercel.app/auth/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://form-mind-ai-agent.vercel.app/auth/callback"

# ------------------------------------------------------------------------------
# Supabase Authentication & Profile Layer (Identity Only)
# ------------------------------------------------------------------------------
# In Supabase Dashboard: Project Settings > API
# Enable Google provider in Authentication > Providers > Google
# Note: Supabase is used strictly for user auth and minimal user profiles.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# Google Analytics 4 (GA4) Configuration
# ------------------------------------------------------------------------------
# Public measurement ID for tracking web traffic and user interactions
VITE_GA_ID="G-SPWVNPXRQZ"
NEXT_PUBLIC_GA_ID="G-SPWVNPXRQZ"

# ------------------------------------------------------------------------------
# AI Provider Configuration
# ------------------------------------------------------------------------------
# Options: 'auto' (built-in zero-cost deterministic engine), 'gemini', 'openai', 'groq'
AI_PROVIDER="auto"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
MODEL_NAME=""

