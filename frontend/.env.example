# ==============================================================================
# FormMind AI - Frontend Environment Variables (.env)
# ==============================================================================
# Copy this file to frontend/.env for local frontend development:
#   Windows (PowerShell): Copy-Item frontend\.env.example frontend\.env
#   Bash:                 cp frontend/.env.example frontend/.env
# ==============================================================================

# Backend API Endpoint URL
# When running backend locally on port 8000:
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Google Analytics 4 Measurement ID (Optional)
VITE_GA_ID=G-SPWVNPXRQZ
NEXT_PUBLIC_GA_ID=G-SPWVNPXRQZ

# Supabase Authentication & Profile Layer (Optional)
# Leave empty for local guest mode or paste your project keys for OAuth login
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
